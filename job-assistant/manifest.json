{
  "manifest_version": 3,
  "name": "Job Application Assistant (user-controlled)",
  "short_name": "Job Assistant",
  "version": "0.3.0",
  "description": "Finds jobs matching Bruno's search, tailors his resume, fills applications, and \u2014 only with his approval, on Greenhouse, Lever and Ashby pages \u2014 submits them after checking each one.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "scripting",
    "tabs",
    "clipboardWrite",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "action": {
    "default_title": "Open Job Assistant"
  },
  "host_permissions": [
    "https://boards-api.greenhouse.io/*",
    "https://api.lever.co/*",
    "https://api.ashbyhq.com/*",
    "https://api.anthropic.com/*"
  ]
}
